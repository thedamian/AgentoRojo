# Non-secret SPA configuration for Entra ID (Azure AD) sign-in via @azure/msal-browser.
# Copy this file to .env and fill in values from your Entra ID app registration.
# Leaving VITE_ENTRA_CLIENT_ID empty runs the app in "stub mode": no Azure DevOps
# sign-in, no x-ado-token header is sent, and a banner explains how to configure it.

# Application (client) ID of the Entra ID app registration used for the SPA (PKCE) flow.
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID the app registration belongs to. Leave unset to default to the
# multi-tenant "organizations" authority.
VITE_ENTRA_TENANT_ID=

# Redirect URI registered on the app registration; must match exactly.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
